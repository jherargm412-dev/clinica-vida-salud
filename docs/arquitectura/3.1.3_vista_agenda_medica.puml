@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "pkg agenda_medica" {
  actor Administrador
  actor Recepcionista
  actor Medico
  package agenda_medica {
    usecase "CU17 Consultar\nAgenda Medica" as CU17
    usecase "CU18 Registrar Atencion\nde Cita" as CU18
  }
  Administrador -- CU17
  Recepcionista -- CU17
  CU17 -- Medico
  CU18 -- Medico
}
@enduml
