@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "pkg citas" {
  actor Recepcionista
  actor Paciente
  package citas {
    usecase "CU12 Consultar\nDisponibilidad" as CU12
    usecase "CU13 Registrar Cita" as CU13
    usecase "CU14 Reprogramar Cita" as CU14
    usecase "CU15 Cancelar Cita" as CU15
    usecase "CU16 Controlar Estado y\nAsistencia de Cita" as CU16
  }
  Recepcionista -- CU12
  Recepcionista -- CU13
  Recepcionista -- CU14
  Recepcionista -- CU15
  Recepcionista -- CU16
  CU12 -- Paciente
  CU13 -- Paciente
  CU13 ..> CU12 : <<include>>
  CU14 ..> CU12 : <<include>>
}
@enduml
