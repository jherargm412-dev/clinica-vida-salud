@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8F8F8
}
title Diagrama de casos de uso general - Ciclo 2

actor Usuario
actor Administrador
actor Recepcionista
actor "Médico" as Medico
actor Paciente

Administrador -up-|> Usuario
Recepcionista -up-|> Usuario
Medico -up-|> Usuario
Paciente -up-|> Usuario

rectangle "Sistema de gestión de citas médicas" {
  package "Usuarios y Acceso" {
    usecase "CU01 Gestionar Usuarios\ny Asignar Roles" as CU01
    usecase "CU02 Iniciar Sesión" as CU02
    usecase "CU03 Gestionar Roles\ny Permisos" as CU03
    usecase "CU04 Configurar Perfil\nde Usuario" as CU04
    usecase "CU05 Consultar Bitácora" as CU05
  }
  package "Médicos, Especialidades y Horarios" {
    usecase "CU09 Gestionar Especialidad" as CU09
    usecase "CU10 Gestionar Médico" as CU10
    usecase "CU11 Gestionar Horario\nde Atención" as CU11
  }
  package "Reportes" {
    usecase "CU19 Generar Reporte" as CU19
  }
  package "Agenda Médica" {
    usecase "CU17 Consultar Agenda\nMédica" as CU17
    usecase "CU18 Registrar Atención\nde Cita" as CU18
  }
  package "Pacientes" {
    usecase "CU06 Gestionar Paciente" as CU06
    usecase "CU07 Gestionar Perfil Médico" as CU07
    usecase "CU08 Consultar Historial\nde Citas" as CU08
  }
  package "Citas Médicas" {
    usecase "CU12 Consultar\nDisponibilidad" as CU12
    usecase "CU13 Registrar Cita" as CU13
    usecase "CU14 Reprogramar Cita" as CU14
    usecase "CU15 Cancelar Cita" as CU15
    usecase "CU16 Controlar Estado y\nAsistencia de Cita" as CU16
  }
  package "Pagos y Caja" {
    usecase "CU20 Gestionar Tarifas\ny Métodos de Pago" as CU20
    usecase "CU21 Pagar Cita" as CU21
    usecase "CU22 Gestionar Caja" as CU22
  }
  package "Asistencia al Usuario" {
    usecase "CU23 Gestionar\nPreguntas Frecuentes" as CU23
    usecase "CU24 Consultar\nAsistente Virtual" as CU24
    usecase "CU25 Navegar por\nComando de Voz" as CU25
  }
}

Usuario -- CU02
Usuario -- CU04
Usuario -- CU25

Administrador -- CU01
Administrador -- CU03
Administrador -- CU05
Administrador -- CU09
Administrador -- CU10
Administrador -- CU11
Administrador -- CU17
Administrador -- CU19
Administrador -- CU20
Administrador -- CU23

Recepcionista -- CU06
Recepcionista -- CU08
Recepcionista -- CU12
Recepcionista -- CU13
Recepcionista -- CU14
Recepcionista -- CU15
Recepcionista -- CU16
Recepcionista -- CU17
Recepcionista -- CU19
Recepcionista -- CU21
Recepcionista -- CU22

Medico -- CU17
Medico -- CU18

CU07 -- Paciente
CU08 -- Paciente
CU12 -- Paciente
CU13 -- Paciente
CU21 -- Paciente
CU24 -- Paciente

CU13 ..> CU12 : <<include>>
CU14 ..> CU12 : <<include>>
CU13 ..> CU21 : <<include>>
@enduml
