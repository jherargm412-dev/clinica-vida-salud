@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "pkg usuarios_acceso" {
  actor Administrador
  actor Usuario
  package usuarios_acceso {
    usecase "CU01 Gestionar Usuarios\ny Asignar Roles" as CU01
    usecase "CU02 Iniciar Sesion" as CU02
    usecase "CU03 Gestionar Roles\ny Permisos" as CU03
    usecase "CU04 Configurar Perfil\nde Usuario" as CU04
    usecase "CU05 Consultar Bitacora" as CU05
  }
  Administrador -- CU01
  Administrador -- CU03
  Administrador -- CU05
  CU02 -- Usuario
  CU04 -- Usuario
}
@enduml
