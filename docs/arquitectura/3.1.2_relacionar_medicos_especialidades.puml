@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "uc Paquete3 medicos_especialidades" {
  package medicos_especialidades {
  }
  usecase "CU11 Gestionar Horario\nde Atencion" as CU11
  usecase "CU10 Gestionar Medico" as CU10
  usecase "CU09 Gestionar\nEspecialidad" as CU09
  medicos_especialidades ..> CU11 : <<trace>>
  medicos_especialidades ..> CU10 : <<trace>>
  medicos_especialidades ..> CU09 : <<trace>>
}
@enduml
