@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "uc asistencia_usuario" {
  actor Administrador
  actor Paciente
  actor Usuario
  package asistencia_usuario {
    usecase "CU23 Gestionar\nPreguntas Frecuentes" as CU23
    usecase "CU24 Consultar\nAsistente Virtual" as CU24
    usecase "CU25 Navegar por\nComando de Voz" as CU25
  }
  Administrador -- CU23
  CU24 -- Paciente
  CU25 -- Usuario
}
@enduml
