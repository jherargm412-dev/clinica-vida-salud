@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8F8F8
}
title Diagrama de casos de uso general - Ciclo 1

actor Usuario
actor Administrador
actor Recepcionista
actor "Médico" as Medico
actor Paciente

Administrador -up-|> Usuario
Recepcionista -up-|> Usuario
Medico -up-|> Usuario
Paciente -up-|> Usuario

rectangle "Sistema de gestión de citas médicas" {
  package "Usuarios y Acceso" {
    usecase "CU01 Gestionar Usuarios\ny Asignar Roles" as CU01
    usecase "CU02 Iniciar Sesión" as CU02
    usecase "CU03 Gestionar Roles\ny Permisos" as CU03
    usecase "CU04 Configurar Perfil\nde Usuario" as CU04
    usecase "CU05 Consultar Bitácora" as CU05
  }
  package "Médicos, Especialidades y Horarios" {
    usecase "CU09 Gestionar Especialidad" as CU09
    usecase "CU10 Gestionar Médico" as CU10
    usecase "CU11 Gestionar Horario\nde Atención" as CU11
  }
  package "Pacientes" {
    usecase "CU06 Gestionar Paciente" as CU06
  }
  package "Citas Médicas" {
    usecase "CU12 Consultar\nDisponibilidad" as CU12
    usecase "CU13 Registrar Cita" as CU13
    usecase "CU14 Reprogramar Cita" as CU14
    usecase "CU15 Cancelar Cita" as CU15
  }
}

Usuario -- CU02
Usuario -- CU04

Administrador -- CU01
Administrador -- CU03
Administrador -- CU05
Administrador -- CU09
Administrador -- CU10
Administrador -- CU11

Recepcionista -- CU06
Recepcionista -- CU12
Recepcionista -- CU13
Recepcionista -- CU14
Recepcionista -- CU15

CU12 -- Paciente
CU13 -- Paciente

CU13 ..> CU12 : <<include>>
CU14 ..> CU12 : <<include>>
@enduml
