@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "uc Paquete5 agenda_medica" {
  package agenda_medica {
  }
  usecase "CU18 Registrar Atencion\nde Cita" as CU18
  usecase "CU17 Consultar\nAgenda Medica" as CU17
  agenda_medica ..> CU18 : <<trace>>
  agenda_medica ..> CU17 : <<trace>>
}
@enduml
