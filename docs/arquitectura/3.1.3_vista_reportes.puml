@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle folder
skinparam ArrowColor #6B6B6B
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F8ECE6
  BorderColor #6B6B6B
}
skinparam usecase {
  BackgroundColor #DCEBFA
  BorderColor #4A6FA5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FBE7C6
  BorderColor #6B6B6B
}
frame "pkg reportes" {
  actor Administrador
  actor Recepcionista
  package reportes {
    usecase "CU19 Generar Reporte" as CU19
  }
  Administrador -- CU19
  Recepcionista -- CU19
}
@enduml
