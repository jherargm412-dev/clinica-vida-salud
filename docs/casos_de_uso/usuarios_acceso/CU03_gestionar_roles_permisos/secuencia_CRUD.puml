@startuml
title CU03 Gestionar Roles y Permisos - Diagrama de secuencia (CRUD completo)
skinparam sequenceMessageAlign left
actor Administrador
boundary UI_Roles
control Ctrl_Roles
entity Rol
entity Permiso
entity Usuario
entity Bitacora
== 1. Listar ==
Administrador -[#000000]> UI_Roles : <color:#000000><b>1</b> seleccionarGestionarRoles()</color>
activate UI_Roles
UI_Roles -[#000000]> Ctrl_Roles : <color:#000000><b>1.1</b> obtenerRoles()</color>
activate Ctrl_Roles
Ctrl_Roles -[#000000]> Rol : <color:#000000><b>1.2</b> listar()</color>
activate Rol
Rol -[#000000]-> Ctrl_Roles : <color:#000000><b>1.3</b> roles</color>
deactivate Rol
Ctrl_Roles -[#000000]-> UI_Roles : <color:#000000><b>1.4</b> roles</color>
deactivate Ctrl_Roles
UI_Roles -[#000000]> UI_Roles : <color:#000000><b>1.5</b> mostrarLista(roles)</color>
== 2. Registrar rol ==
Administrador -[#1F5FBF]> UI_Roles : <color:#1F5FBF><b>2</b> seleccionarNuevoRol()</color>
UI_Roles -[#1F5FBF]> Ctrl_Roles : <color:#1F5FBF><b>2.1</b> obtenerPermisos()</color>
activate Ctrl_Roles
Ctrl_Roles -[#1F5FBF]> Permiso : <color:#1F5FBF><b>2.2</b> listar()</color>
activate Permiso
Permiso -[#1F5FBF]-> Ctrl_Roles : <color:#1F5FBF><b>2.3</b> permisos</color>
deactivate Permiso
Ctrl_Roles -[#1F5FBF]-> UI_Roles : <color:#1F5FBF><b>2.4</b> permisos</color>
deactivate Ctrl_Roles
UI_Roles -[#1F5FBF]> UI_Roles : <color:#1F5FBF><b>2.5</b> mostrarFormulario(permisos)</color>
Administrador -[#1F5FBF]> UI_Roles : <color:#1F5FBF><b>2.6</b> guardar(nombre, descripcion, permisosMarcados)</color>
UI_Roles -[#1F5FBF]> Ctrl_Roles : <color:#1F5FBF><b>2.7</b> registrarRol(nombre, descripcion, permisosMarcados)</color>
activate Ctrl_Roles
Ctrl_Roles -[#1F5FBF]> Ctrl_Roles : <color:#1F5FBF><b>2.8</b> validarDatos(nombre, permisosMarcados)</color>
alt nombre vacio
  Ctrl_Roles -[#1F5FBF]-> UI_Roles : <color:#1F5FBF><b>2.9</b> "Ingrese el nombre del rol"</color>
else ningun permiso marcado
  Ctrl_Roles -[#1F5FBF]-> UI_Roles : <color:#1F5FBF><b>2.10</b> "Seleccione al menos un permiso"</color>
else datos completos
  Ctrl_Roles -[#1F5FBF]> Rol : <color:#1F5FBF><b>2.11</b> existeNombre(nombre)</color>
  activate Rol
  Rol -[#1F5FBF]-> Ctrl_Roles : <color:#1F5FBF><b>2.12</b> existe</color>
  deactivate Rol
  alt existe = verdadero
    Ctrl_Roles -[#1F5FBF]-> UI_Roles : <color:#1F5FBF><b>2.13</b> "Ya existe un rol con ese nombre"</color>
  else existe = falso
    Ctrl_Roles -[#1F5FBF]> Rol : <color:#1F5FBF><b>2.14</b> guardar(nombre, descripcion, permisosMarcados)</color>
    activate Rol
    Rol -[#1F5FBF]-> Ctrl_Roles : <color:#1F5FBF><b>2.15</b> rol</color>
    deactivate Rol
    Ctrl_Roles -[#1F5FBF]> Bitacora : <color:#1F5FBF><b>2.16</b> registrar(administrador, "Registrar rol", detalle, ip)</color>
    activate Bitacora
    Bitacora -[#1F5FBF]-> Ctrl_Roles : <color:#1F5FBF><b>2.17</b> ok</color>
    deactivate Bitacora
    Ctrl_Roles -[#1F5FBF]-> UI_Roles : <color:#1F5FBF><b>2.18</b> "Rol registrado"</color>
  end
end
deactivate Ctrl_Roles
UI_Roles -[#1F5FBF]> UI_Roles : <color:#1F5FBF><b>2.19</b> mostrarMensaje(mensaje)</color>
== 3. Modificar rol ==
Administrador -[#D9730D]> UI_Roles : <color:#D9730D><b>3</b> seleccionarEditar(idRol)</color>
UI_Roles -[#D9730D]> Ctrl_Roles : <color:#D9730D><b>3.1</b> obtenerRol(idRol)</color>
activate Ctrl_Roles
Ctrl_Roles -[#D9730D]> Rol : <color:#D9730D><b>3.2</b> buscarConPermisos(idRol)</color>
activate Rol
Rol -[#D9730D]-> Ctrl_Roles : <color:#D9730D><b>3.3</b> rol</color>
deactivate Rol
Ctrl_Roles -[#D9730D]> Permiso : <color:#D9730D><b>3.4</b> listar()</color>
activate Permiso
Permiso -[#D9730D]-> Ctrl_Roles : <color:#D9730D><b>3.5</b> permisos</color>
deactivate Permiso
Ctrl_Roles -[#D9730D]-> UI_Roles : <color:#D9730D><b>3.6</b> rol, permisos</color>
deactivate Ctrl_Roles
UI_Roles -[#D9730D]> UI_Roles : <color:#D9730D><b>3.7</b> mostrarFormulario(rol, permisos)</color>
Administrador -[#D9730D]> UI_Roles : <color:#D9730D><b>3.8</b> guardar(nombre, descripcion, permisosMarcados)</color>
UI_Roles -[#D9730D]> Ctrl_Roles : <color:#D9730D><b>3.9</b> modificarRol(idRol, nombre, descripcion, permisosMarcados)</color>
activate Ctrl_Roles
Ctrl_Roles -[#D9730D]> Ctrl_Roles : <color:#D9730D><b>3.10</b> validarDatos(nombre, permisosMarcados)</color>
alt nombre vacio
  Ctrl_Roles -[#D9730D]-> UI_Roles : <color:#D9730D><b>3.11</b> "Ingrese el nombre del rol"</color>
else ningun permiso marcado
  Ctrl_Roles -[#D9730D]-> UI_Roles : <color:#D9730D><b>3.12</b> "Seleccione al menos un permiso"</color>
else datos completos
  Ctrl_Roles -[#D9730D]> Rol : <color:#D9730D><b>3.13</b> existeNombreEnOtro(nombre, idRol)</color>
  activate Rol
  Rol -[#D9730D]-> Ctrl_Roles : <color:#D9730D><b>3.14</b> existe</color>
  deactivate Rol
  alt existe = verdadero
    Ctrl_Roles -[#D9730D]-> UI_Roles : <color:#D9730D><b>3.15</b> "Ya existe un rol con ese nombre"</color>
  else existe = falso
    Ctrl_Roles -[#D9730D]> Rol : <color:#D9730D><b>3.16</b> actualizar(idRol, nombre, descripcion, permisosMarcados)</color>
    activate Rol
    Rol -[#D9730D]-> Ctrl_Roles : <color:#D9730D><b>3.17</b> ok</color>
    deactivate Rol
    Ctrl_Roles -[#D9730D]> Bitacora : <color:#D9730D><b>3.18</b> registrar(administrador, "Modificar rol", detalle, ip)</color>
    activate Bitacora
    Bitacora -[#D9730D]-> Ctrl_Roles : <color:#D9730D><b>3.19</b> ok</color>
    deactivate Bitacora
    Ctrl_Roles -[#D9730D]-> UI_Roles : <color:#D9730D><b>3.20</b> "Rol actualizado"</color>
  end
end
deactivate Ctrl_Roles
UI_Roles -[#D9730D]> UI_Roles : <color:#D9730D><b>3.21</b> mostrarMensaje(mensaje)</color>
== 4. Consultar rol ==
Administrador -[#2E8B57]> UI_Roles : <color:#2E8B57><b>4</b> seleccionarVer(idRol)</color>
UI_Roles -[#2E8B57]> Ctrl_Roles : <color:#2E8B57><b>4.1</b> obtenerRol(idRol)</color>
activate Ctrl_Roles
Ctrl_Roles -[#2E8B57]> Rol : <color:#2E8B57><b>4.2</b> buscarConPermisos(idRol)</color>
activate Rol
Rol -[#2E8B57]-> Ctrl_Roles : <color:#2E8B57><b>4.3</b> rol</color>
deactivate Rol
Ctrl_Roles -[#2E8B57]-> UI_Roles : <color:#2E8B57><b>4.4</b> rol</color>
deactivate Ctrl_Roles
UI_Roles -[#2E8B57]> UI_Roles : <color:#2E8B57><b>4.5</b> mostrarDetalle(rol)</color>
== 5. Deshabilitar rol ==
Administrador -[#C0392B]> UI_Roles : <color:#C0392B><b>5</b> seleccionarDeshabilitar(idRol)</color>
UI_Roles -[#C0392B]> UI_Roles : <color:#C0392B><b>5.1</b> mostrarConfirmacion()</color>
Administrador -[#C0392B]> UI_Roles : <color:#C0392B><b>5.2</b> confirmar()</color>
UI_Roles -[#C0392B]> Ctrl_Roles : <color:#C0392B><b>5.3</b> deshabilitarRol(idRol)</color>
activate Ctrl_Roles
Ctrl_Roles -[#C0392B]> Ctrl_Roles : <color:#C0392B><b>5.4</b> esRolAdministrador(idRol)</color>
alt es rol Administrador
  Ctrl_Roles -[#C0392B]-> UI_Roles : <color:#C0392B><b>5.5</b> "El rol Administrador no se puede deshabilitar"</color>
else otro rol
  Ctrl_Roles -[#C0392B]> Usuario : <color:#C0392B><b>5.6</b> contarActivosPorRol(idRol)</color>
  activate Usuario
  Usuario -[#C0392B]-> Ctrl_Roles : <color:#C0392B><b>5.7</b> cantidad</color>
  deactivate Usuario
  alt cantidad > 0
    Ctrl_Roles -[#C0392B]-> UI_Roles : <color:#C0392B><b>5.8</b> "El rol tiene usuarios activos asignados"</color>
  else cantidad = 0
    Ctrl_Roles -[#C0392B]> Rol : <color:#C0392B><b>5.9</b> cambiarEstado(idRol, "inactivo")</color>
    activate Rol
    Rol -[#C0392B]-> Ctrl_Roles : <color:#C0392B><b>5.10</b> ok</color>
    deactivate Rol
    Ctrl_Roles -[#C0392B]> Bitacora : <color:#C0392B><b>5.11</b> registrar(administrador, "Deshabilitar rol", detalle, ip)</color>
    activate Bitacora
    Bitacora -[#C0392B]-> Ctrl_Roles : <color:#C0392B><b>5.12</b> ok</color>
    deactivate Bitacora
    Ctrl_Roles -[#C0392B]-> UI_Roles : <color:#C0392B><b>5.13</b> "Rol deshabilitado"</color>
  end
end
deactivate Ctrl_Roles
UI_Roles -[#C0392B]> UI_Roles : <color:#C0392B><b>5.14</b> mostrarMensaje(mensaje)</color>
deactivate UI_Roles
@enduml
