@startuml
title CU22 Gestionar Caja - Diagrama de comunicación
left to right direction
skinparam linetype polyline
skinparam defaultTextAlignment left
skinparam shadowing false

actor Recepcionista
boundary UI_Caja
control Ctrl_Caja
entity SesionCaja
entity MovimientoCaja
entity Pago
entity Bitacora

Recepcionista -- UI_Caja : "<color:#000000>1: mostrarCaja() →</color>\n<color:#1F5FBF>2: abrirCaja(montoInicial) →</color>\n<color:#D9730D>3: consultarCaja() →</color>\n<color:#2E8B57>4: cerrarCaja(montoContado) →</color>\n<color:#2E8B57>4.1: confirmarCierre() →</color>"

UI_Caja -- Ctrl_Caja : "<color:#000000>1.1: obtenerCajaActual() →</color>\n<color:#000000>1.3: cajaAbierta ←</color>\n<color:#1F5FBF>2.1: registrarApertura(montoInicial) →</color>\n<color:#1F5FBF>2.5: 'Caja abierta', sesion ←</color>\n<color:#D9730D>3.1: obtenerResumenCaja(idSesionCaja) →</color>\n<color:#D9730D>3.3: sesion, ingresos, totalIngresos, montoEsperado ←</color>\n<color:#2E8B57>4.2: registrarCierre(idSesionCaja, montoContado) →</color>\n<color:#2E8B57>4.7: 'Caja cerrada', resumenCierre ←</color>"

Ctrl_Caja -- SesionCaja : "<color:#000000>1.2: obtenerAbiertaPorUsuario(idUsuario) →</color>\n<color:#1F5FBF>2.2: obtenerAbiertaPorUsuario(idUsuario) →</color>\n<color:#1F5FBF>2.3: insertarSesion(idUsuario, montoInicial) →</color>\n<color:#2E8B57>4.5: cerrarSesion(idSesionCaja, montoContado, diferencia) →</color>"

Ctrl_Caja -- MovimientoCaja : "<color:#D9730D>3.2: listarPorSesion(idSesionCaja) →</color>\n<color:#2E8B57>4.4: sumarPorSesion(idSesionCaja) →</color>"

Ctrl_Caja -- Pago : "<color:#2E8B57>4.3: existePagoEfectivoEnCurso(idUsuario) →</color>"

Ctrl_Caja -- Bitacora : "<color:#1F5FBF>2.4: registrar(recepcionista, 'Abrir caja', detalle, ip) →</color>\n<color:#2E8B57>4.6: registrar(recepcionista, 'Cerrar caja', detalle, ip) →</color>"

legend right
  <color:#000000>1: Mostrar caja</color>
  <color:#1F5FBF>2: Abrir caja</color>
  <color:#D9730D>3: Consultar caja</color>
  <color:#2E8B57>4: Cerrar caja</color>
endlegend
@enduml
