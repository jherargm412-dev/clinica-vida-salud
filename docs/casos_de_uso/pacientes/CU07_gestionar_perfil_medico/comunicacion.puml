@startuml
left to right direction
skinparam shadowing false
skinparam actorStyle uml
skinparam linetype polyline
skinparam dpi 200

title DIAGRAMA DE COMUNICACIÓN - CU07 Gestionar Perfil Médico

actor "Paciente" as PA
boundary "UI_perfil_medico" as UI
control "PerfilMedicoController" as C
entity "Usuario" as U
entity "Paciente" as P
entity "PerfilMedico" as PM
entity "Bitacora" as B

PA -- UI : 1: abrirMiPerfilMedico()

UI -- C : 1.1: mostrarPerfilMedico(idUsuario)

C -- U : 1.2: obtenerPorId(idUsuario)
C -- P : 1.3: obtenerPorIdUsuario(idUsuario)
C -- PM : 1.4: obtenerPorIdPaciente(idPaciente)

C -- UI : 1.5: mostrarFormulario(datosPerfil)

PA -- UI : 2: guardarPerfilMedico(datos)
UI -- C : 2.1: actualizarPerfilMedico(idUsuario, datos)

C -- U : 2.2: obtenerPorId(idUsuario)
C -- P : 2.3: obtenerPorIdUsuario(idUsuario)
C -- PM : 2.4: validarDatos(datos)
C -- PM : 2.5: guardarOActualizar(idPaciente, datos)
C -- B : 2.6: registrarAccion(idUsuario, "ACTUALIZAR", "PerfilMedico", "Actualización de perfil médico")
C -- PM : 2.7: obtenerPorIdPaciente(idPaciente)
C -- UI : 2.8: mostrarPerfilActualizado(datosPerfil)

@enduml