C -- RO : 3.4: obtenerPorNombre(nombre) →

C -- CI : 5.3: existenCitasPendientesPaciente(idPaciente) →

C -- B : 3.8: registrarAccion(accion, tablaAfectada, detalle) →\n4.6: registrarAccion(accion, tablaAfectada, detalle) →\n5.6: registrarAccion(accion, tablaAfectada, detalle) →\n6.5: registrarAccion(accion, tablaAfectada, detalle) →
