@startuml
title CU25 Navegar por Comando de Voz - Diagrama de comunicación
left to right direction
skinparam linetype polyline
skinparam defaultTextAlignment left
skinparam shadowing false

actor Usuario
boundary UI_ComandoVoz
control Ctrl_ComandoVoz
entity "Usuario" as UsuarioEntidad
entity Especialidad

Usuario -- UI_ComandoVoz : "<color:#000000>1: presionarMicrofono() →</color>\n<color:#000000>1.1: decirComando(voz) →</color>\n<color:#1F5FBF>2: mostrarComandosDisponibles() →</color>\n<color:#D9730D>3: cancelarEscucha() →</color>"

UI_ComandoVoz -- Ctrl_ComandoVoz : "<color:#000000>1.2: interpretarComando(texto) →</color>\n<color:#000000>1.5: pantallaDestino, 'Comando: [texto]' ←</color>\n<color:#1F5FBF>2.1: obtenerComandosDisponibles(usuario) →</color>\n<color:#1F5FBF>2.4: comandos ←</color>"

Ctrl_ComandoVoz -- UsuarioEntidad : "<color:#000000>1.3: tienePermiso(clave) →</color>\n<color:#1F5FBF>2.2: tienePermiso(clave) →</color>\n<color:#1F5FBF>2.3: esMedico(), esPaciente() →</color>"

Ctrl_ComandoVoz -- Especialidad : "<color:#000000>1.4: listarActivas() → (solo en \"disponibilidad de\")</color>"

legend right
  <color:#000000>1: Navegar por comando de voz</color>
  <color:#1F5FBF>2: Ver comandos disponibles</color>
  <color:#D9730D>3: Cancelar escucha</color>
endlegend
@enduml
