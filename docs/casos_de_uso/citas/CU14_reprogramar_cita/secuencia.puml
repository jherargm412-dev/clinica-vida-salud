@startuml
autonumber
skinparam shadowing false
skinparam dpi 200

title DIAGRAMA DE SECUENCIA - CU14 Reprogramar Cita

actor "Recepcionista" as R
boundary "UI_reprogramarCita" as UI
control "CitaController" as C
control "DisponibilidadController" as D
entity "Cita" as CI
entity "Medico" as M
entity "HorarioAtencion" as H
entity "Bitacora" as B
entity "Notificacion" as N
control "Notificador" as NT

== 1. Mostrar Citas ==
R -> UI: mostrarCitasReprogramables()
UI -> C: listarCitasReprogramables()
C -> CI: listarReprogramables()

== 2. Buscar Cita ==
R -> UI: buscarCita()
UI -> C: buscarCitasReprogramables(texto, fecha)
C -> CI: buscarReprogramables(texto, fecha)

== 3. Seleccionar Cita ==
R -> UI: seleccionarCita()
UI -> C: obtenerCitaReprogramable(idCita)
C -> CI: obtenerDetallePorId(idCita)

== 4. Consultar Disponibilidad (include CU12) ==
R -> UI: consultarDisponibilidad()
UI -> D: consultarHorariosDisponibles(idMedico, fecha)

== 5. Guardar Reprogramación ==
R -> UI: guardarReprogramacion()
UI -> C: reprogramarCita(idCita, nuevaFecha, nuevaHoraInicio)
C -> CI: obtenerDetallePorId(idCita)
C -> M: obtenerPorId(idMedico)
C -> H: listarHorariosActivosPorDia(idMedico, diaSemana)
C -> CI: existeCitaSuperpuesta(idMedico, nuevaFecha, nuevaHoraInicio, nuevaHoraFin, idCita)
C -> CI: existeCitaSuperpuestaPaciente(idPaciente, nuevaFecha, nuevaHoraInicio, nuevaHoraFin, idCita)
C -> CI: actualizarFechaHoraCita(nuevaFecha, nuevaHoraInicio, nuevaHoraFin)
C -> B: registrarAccion(accion, tablaAfectada, detalle)
C -> N: programarRecordatorio(cita) [mueve el recordatorio 24 h; no se crea si falta menos]
C -> N: registrarAviso(idCita, "Cita reprogramada")
C -> NT: enviar(aviso) [despues de guardar: push y, si no hay o falla, correo]
UI --> R: mostrarConfirmacion()

@enduml
