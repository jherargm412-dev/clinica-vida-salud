@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 120
title CU10 Gestionar Medico - Diagrama de comunicacion (CRUD completo)
actor Administrador
boundary UI_Medicos
control Ctrl_Medicos
entity Especialidad
entity Medico
entity Usuario
entity Bitacora
