@startuml
title CU09 Gestionar Especialidad - Diagrama de secuencia (Modificar especialidad)
actor Administrador
boundary UI_Especialidades
control Ctrl_Especialidades
entity Especialidad
entity Bitacora
autonumber
Administrador -> UI_Especialidades : seleccionarGestionarEspecialidades()
activate UI_Especialidades
UI_Especialidades -> Ctrl_Especialidades : obtenerEspecialidades()
activate Ctrl_Especialidades
Ctrl_Especialidades -> Especialidad : listar()
activate Especialidad
Especialidad --> Ctrl_Especialidades : especialidades
deactivate Especialidad
Ctrl_Especialidades --> UI_Especialidades : especialidades
deactivate Ctrl_Especialidades
UI_Especialidades -> UI_Especialidades : mostrarLista(especialidades)
Administrador -> UI_Especialidades : seleccionarEditar(idEspecialidad)
UI_Especialidades -> Ctrl_Especialidades : obtenerEspecialidad(idEspecialidad)
activate Ctrl_Especialidades
Ctrl_Especialidades -> Especialidad : buscarPorId(idEspecialidad)
activate Especialidad
Especialidad --> Ctrl_Especialidades : especialidad
deactivate Especialidad
Ctrl_Especialidades --> UI_Especialidades : especialidad
deactivate Ctrl_Especialidades
UI_Especialidades -> UI_Especialidades : mostrarFormulario(especialidad)
Administrador -> UI_Especialidades : guardar(nombre, descripcion)
UI_Especialidades -> Ctrl_Especialidades : modificarEspecialidad(idEspecialidad, nombre, descripcion)
activate Ctrl_Especialidades
Ctrl_Especialidades -> Ctrl_Especialidades : validarNombre(nombre)
alt nombre vacio
  Ctrl_Especialidades --> UI_Especialidades : "Ingrese el nombre de la especialidad"
else nombre ingresado
  Ctrl_Especialidades -> Ctrl_Especialidades : normalizar(nombre)
  Ctrl_Especialidades -> Especialidad : existeNombreEnOtra(nombreNormalizado, idEspecialidad)
  activate Especialidad
  Especialidad --> Ctrl_Especialidades : existe
  deactivate Especialidad
  alt existe = verdadero
    Ctrl_Especialidades --> UI_Especialidades : "Ya existe una especialidad con ese nombre"
  else existe = falso
    Ctrl_Especialidades -> Especialidad : actualizar(idEspecialidad, nombre, descripcion)
    activate Especialidad
    Especialidad --> Ctrl_Especialidades : ok
    deactivate Especialidad
    Ctrl_Especialidades -> Bitacora : registrar(administrador, "Modificar especialidad", detalle, ip)
    activate Bitacora
    Bitacora --> Ctrl_Especialidades : ok
    deactivate Bitacora
    Ctrl_Especialidades --> UI_Especialidades : "Especialidad actualizada"
  end
end
deactivate Ctrl_Especialidades
UI_Especialidades -> UI_Especialidades : mostrarMensaje(mensaje)
deactivate UI_Especialidades
@enduml
