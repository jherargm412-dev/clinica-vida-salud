@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 110
skinparam classAttributeIconSize 0
hide circle
hide methods
title Diagrama de clases de la base de datos - Ciclo 2

' Sin PK ni FK (eso va en el mapeo / diccionario). Las tablas puente rol_permiso y
' medico_especialidad se representan como asociaciones muchos a muchos.

class Rol {
  nombre : String
  descripcion : String
  activo : Boolean
}
class Permiso {
  clave : String
  nombre : String
  descripcion : String
}
class Usuario {
  nombreUsuario : String
  correo : String
  contrasena : String
  nombres : String
  apellidos : String
  activo : Boolean
  bloqueado : Boolean
  intentosFallidos : Integer
  fechaRegistro : DateTime
}
class Bitacora {
  fechaHora : DateTime
  accion : String
  tablaAfectada : String
  detalle : String
  ip : String
}
class RecuperacionContrasena {
  token : String
  fechaSolicitud : DateTime
  fechaExpiracion : DateTime
  usado : Boolean
}
class SuscripcionPush {
  endpoint : String
  claveP256dh : String
  claveAuth : String
  dispositivo : String
  activo : Boolean
  fechaRegistro : DateTime
}
class Paciente {
  codigo : String
  ci : String
  fechaNacimiento : Date
  sexo : String
  telefono : String
  direccion : String
  activo : Boolean
}
class PerfilMedico {
  tipoSangre : String
  alergias : String
  enfermedadesCronicas : String
  medicamentos : String
  nombreContactoEmergencia : String
  parentescoContactoEmergencia : String
  telefonoContactoEmergencia : String
  fechaActualizacion : DateTime
}
class Medico {
  codigo : String
  registroProfesional : String
  telefono : String
  activo : Boolean
}
class Especialidad {
  nombre : String
  descripcion : String
  activo : Boolean
}
class HorarioAtencion {
  diaSemana : Integer
  horaInicio : Time
  horaFin : Time
  duracionCita : Integer
  activo : Boolean
}
class Cita {
  codigo : String
  fecha : Date
  horaInicio : Time
  horaFin : Time
  motivo : String
  estado : String
  fechaCreacion : DateTime
  motivoCancelacion : String
  fechaCancelacion : DateTime
  canceladaPor : String
}
class AtencionMedica {
  diagnostico : String
  notasClinicas : String
  fechaHoraRegistro : DateTime
}
class Notificacion {
  tipo : String
  canal : String
  programadaPara : DateTime
  enviadaEn : DateTime
  estado : String
}
class Tarifa {
  monto : Decimal
  vigenteDesde : Date
  activo : Boolean
}
class MetodoPago {
  nombre : String
  enLinea : Boolean
  activo : Boolean
}
class Pago {
  numeroComprobante : String
  montoTotal : Decimal
  fecha : DateTime
  estado : String
}
class DetallePago {
  monto : Decimal
  referenciaExterna : String
  sesionPasarela : String
  estado : String
}
class SesionCaja {
  apertura : DateTime
  montoInicial : Decimal
  cierre : DateTime
  montoContado : Decimal
  diferencia : Decimal
  estado : String
}
class MovimientoCaja {
  tipo : String
  monto : Decimal
  fecha : DateTime
}
class PreguntaFrecuente {
  categoria : String
  pregunta : String
  respuesta : String
  palabrasClave : String
  activo : Boolean
  fechaRegistro : DateTime
}

' Usuarios y acceso
Rol "0..*" -- "1..*" Permiso : tiene
Rol "1" -- "0..*" Usuario : asigna
Usuario "0..1" -- "0..*" Bitacora : registra
Usuario "1" -- "0..*" RecuperacionContrasena : solicita
Usuario "1" -- "0..*" SuscripcionPush : activa

' Pacientes y médicos
Usuario "1" -- "0..1" Paciente : tiene
Usuario "1" -- "0..1" Medico : tiene
Paciente "1" -- "0..1" PerfilMedico : tiene
Medico "0..*" -- "1..*" Especialidad : atiende
Medico "1" *-- "0..*" HorarioAtencion : tiene

' Citas y agenda
Paciente "1" -- "0..*" Cita : tiene
Medico "1" -- "0..*" Cita : atiende
Especialidad "1" -- "0..*" Cita : clasifica
Usuario "0..1" -- "0..*" Cita : cancela
Cita "1" -- "0..1" AtencionMedica : registra
Medico "1" -- "0..*" AtencionMedica : registra
Cita "1" -- "0..*" Notificacion : genera

' Pagos y caja
Especialidad "1" -- "0..*" Tarifa : tiene
Cita "1" -- "0..1" Pago : tiene
Usuario "1" -- "0..*" Pago : registra
Pago "1" *-- "1..*" DetallePago : contiene
MetodoPago "1" -- "0..*" DetallePago : clasifica
Usuario "1" -- "0..*" SesionCaja : abre
SesionCaja "1" *-- "0..*" MovimientoCaja : registra
DetallePago "1" -- "0..1" MovimientoCaja : genera
@enduml
