@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 110
skinparam classAttributeIconSize 0
hide circle
hide methods
title Diagrama de clases de la base de datos - Ciclo 2

class Permiso {
  idPermiso : Integer
  clave : String
  nombre : String
  descripcion : String
}
class RolPermiso {
  idRol : Integer
  idPermiso : Integer
}
class Rol {
  idRol : Integer
  nombre : String
  descripcion : String
  activo : Boolean
}
class Usuario {
  idUsuario : Integer
  nombreUsuario : String
  correo : String
  contrasena : String
  nombres : String
  apellidos : String
  activo : Boolean
  bloqueado : Boolean
  intentosFallidos : Integer
  fechaRegistro : DateTime
  idRol : Integer
}
class Bitacora {
  idBitacora : Integer
  fechaHora : DateTime
  accion : String
  tablaAfectada : String
  detalle : String
  ip : String
  idUsuario : Integer
}
class RecuperacionContrasena {
  idRecuperacion : Integer
  token : String
  fechaSolicitud : DateTime
  fechaExpiracion : DateTime
  usado : Boolean
  idUsuario : Integer
}
class Medico {
  idMedico : Integer
  codigo : String
  registroProfesional : String
  telefono : String
  activo : Boolean
  idUsuario : Integer
}
class Paciente {
  idPaciente : Integer
  codigo : String
  ci : String
  fechaNacimiento : Date
  sexo : String
  telefono : String
  direccion : String
  activo : Boolean
  idUsuario : Integer
}
class MedicoEspecialidad {
  idMedico : Integer
  idEspecialidad : Integer
}
class Especialidad {
  idEspecialidad : Integer
  nombre : String
  descripcion : String
  activo : Boolean
}
class HorarioAtencion {
  idHorario : Integer
  diaSemana : Integer
  horaInicio : Time
  horaFin : Time
  duracionCita : Integer
  activo : Boolean
  idMedico : Integer
}
class Cita {
  idCita : Integer
  codigo : String
  fecha : Date
  horaInicio : Time
  horaFin : Time
  motivo : String
  estado : String
  fechaCreacion : DateTime
  motivoCancelacion : String
  fechaCancelacion : DateTime
  canceladaPor : String
  idPaciente : Integer
  idMedico : Integer
  idEspecialidad : Integer
  idUsuarioCancelacion : Integer
}
class Tarifa {
  idTarifa : Integer
  monto : Decimal
  vigenteDesde : Date
  activo : Boolean
  idEspecialidad : Integer
}
class MetodoPago {
  idMetodoPago : Integer
  nombre : String
  enLinea : Boolean
  activo : Boolean
}
class SesionCaja {
  idSesionCaja : Integer
  apertura : DateTime
  montoInicial : Decimal
  cierre : DateTime
  montoContado : Decimal
  diferencia : Decimal
  estado : String
  idUsuario : Integer
}
class Pago {
  idPago : Integer
  numeroComprobante : String
  montoTotal : Decimal
  fecha : DateTime
  estado : String
  idCita : Integer
  idUsuario : Integer
}
class DetallePago {
  idDetallePago : Integer
  monto : Decimal
  referenciaExterna : String
  idSesionPasarela : String
  estado : String
  idPago : Integer
  idMetodoPago : Integer
}
class MovimientoCaja {
  idMovimientoCaja : Integer
  tipo : String
  monto : Decimal
  fecha : DateTime
  idSesionCaja : Integer
  idDetallePago : Integer
}
class Notificacion {
  idNotificacion : Integer
  tipo : String
  canal : String
  programadaPara : DateTime
  enviadaEn : DateTime
  estado : String
  idCita : Integer
}

Permiso "1" -- "0..*" RolPermiso
RolPermiso "1..*" -- "1" Rol
Rol "1" -- "0..*" Usuario : tiene
Usuario "0..1" -- "0..*" Bitacora : registra
Usuario "1" -- "0..*" RecuperacionContrasena : solicita
Usuario "1" -- "0..1" Medico : tiene
Usuario "1" -- "0..1" Paciente : tiene
Usuario "0..1" -- "0..*" Cita : cancela
Medico "1" -- "1..*" MedicoEspecialidad
MedicoEspecialidad "0..*" -- "1" Especialidad
Medico "1" *-- "0..*" HorarioAtencion : tiene
Medico "1" -- "0..*" Cita : atiende
Paciente "1" -- "0..*" Cita : tiene
Especialidad "1" -- "0..*" Cita : clasifica
Especialidad "1" -- "0..*" Tarifa : tiene
Cita "1" -- "0..1" Pago : tiene
Cita "1" -- "0..*" Notificacion : tiene
Usuario "1" -- "0..*" Pago : registra
Pago "1" *-- "1..*" DetallePago : contiene
DetallePago "0..*" -- "1" MetodoPago : clasifica
DetallePago "1" -- "0..1" MovimientoCaja : genera
Usuario "1" -- "0..*" SesionCaja : abre
SesionCaja "1" *-- "0..*" MovimientoCaja : registra
@enduml
